{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/CantonFair",
      "destination": "/hoichocanton",
      "statusCode": 301
    },
    {
      "source": "/cantonfair",
      "destination": "/hoichocanton",
      "statusCode": 301
    },
    {
      "source": "/hoichocanton/",
      "destination": "/hoichocanton",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sanpham",
      "destination": "https://seven-travel-tour-catalog.vercel.app/sanpham"
    },
    {
      "source": "/sanpham/:path*",
      "destination": "https://seven-travel-tour-catalog.vercel.app/sanpham/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://seven-travel-tour-catalog.vercel.app/_next/:path*"
    },
    {
      "source": "/images/seven-travel-logo.png",
      "destination": "https://seven-travel-tour-catalog.vercel.app/images/seven-travel-logo.png"
    },
    {
      "source": "/images/seven-travel-logo-white.png",
      "destination": "https://seven-travel-tour-catalog.vercel.app/images/seven-travel-logo-white.png"
    },
    {
      "source": "/hoichocanton",
      "destination": "/canton-fair/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
